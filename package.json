{
  "name": "yerevan-hood",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Yerevan Hood — Kond Street Brawler (PixiJS beat-'em-up)",
  "scripts": {
    "serve": "npx -y serve -l 8123 .",
    "lint": "eslint .",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "check": "npm run lint && npm test && npm run test:e2e",
    "assets:audit": "node scripts/audit_assets.mjs",
    "assets:slice": ".venv/bin/python scripts/slice_all_characters.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "globals": "^16.0.0",
    "puppeteer-core": "^23.11.0"
  }
}
